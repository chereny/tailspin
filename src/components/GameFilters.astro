---
import type { Category, Publisher } from '../types/game';

interface Props {
    categories: Category[];
    publishers: Publisher[];
}

const { categories, publishers } = Astro.props;
---

<form
    class="mb-8 bg-slate-800/60 rounded-xl border border-slate-700/50 p-5 flex flex-col gap-5 md:flex-row md:items-start md:justify-between"
    aria-label="Filter games"
    data-testid="game-filters"
>
    <fieldset class="min-w-0">
        <legend class="text-sm font-medium text-slate-200 mb-2">Categories</legend>
        <div class="flex flex-wrap gap-2">
            {categories.map((category) => (
                <label
                    class="inline-flex items-center gap-2 rounded-lg border border-slate-600 bg-slate-900/60 px-3 py-1.5 text-sm text-slate-200 cursor-pointer hover:border-blue-500/60 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-blue-500 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-900/40"
                >
                    <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class="h-4 w-4 accent-blue-500 focus:outline-none"
                        data-testid={`filter-category-${category.id}`}
                    />
                    <span>{category.name}</span>
                </label>
            ))}
        </div>
    </fieldset>

    <div class="flex flex-col gap-1 md:w-64">
        <label for="filter-publisher" class="text-sm font-medium text-slate-200">Publisher</label>
        <select
            id="filter-publisher"
            name="publisher"
            class="rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-sm text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="filter-publisher"
        >
            <option value="">All publishers</option>
            {publishers.map((publisher) => (
                <option value={publisher.id}>{publisher.name}</option>
            ))}
        </select>
    </div>

    <div class="flex flex-col gap-2 md:items-end md:self-end">
        <p class="text-sm text-slate-300" role="status" aria-live="polite" data-testid="filter-result-count"></p>
        <button
            type="button"
            class="rounded-lg bg-slate-700 px-4 py-2 text-sm font-medium text-slate-100 hover:bg-slate-600 transition-colors focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="filter-clear"
        >
            Clear filters
        </button>
    </div>
</form>

<script>
    import { matchesFilters, parseFilters, serializeFilters, type FilterSelection } from '../lib/filters';

    const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
    const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty-state"]');
    const count = document.querySelector<HTMLElement>('[data-testid="filter-result-count"]');
    const clearButton = document.querySelector<HTMLButtonElement>('[data-testid="filter-clear"]');

    if (form && grid && emptyState && count && clearButton) {
        const categoryInputs = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="category"]'));
        const publisherSelect = form.querySelector<HTMLSelectElement>('select[name="publisher"]');

        /** Reads the current selection from the form controls. */
        const readSelection = (): FilterSelection => ({
            categoryIds: categoryInputs.filter((input) => input.checked).map((input) => Number(input.value)),
            publisherIds: publisherSelect && publisherSelect.value ? [Number(publisherSelect.value)] : [],
        });

        /**
         * Updates the form controls to reflect a selection.
         * @param selection - The selection to display.
         */
        const writeSelection = (selection: FilterSelection): void => {
            for (const input of categoryInputs) {
                input.checked = selection.categoryIds.includes(Number(input.value));
            }
            if (publisherSelect) {
                const id = selection.publisherIds[0];
                const hasOption = id !== undefined && Array.from(publisherSelect.options).some((o) => o.value === String(id));
                publisherSelect.value = hasOption ? String(id) : '';
            }
        };

        /** Shows or hides cards for the current selection and syncs the count, empty state, and URL. */
        const apply = (): void => {
            const selection = readSelection();
            let visible = 0;
            for (const card of cards) {
                const match = matchesFilters(
                    {
                        categoryId: card.dataset.categoryId ? Number(card.dataset.categoryId) : null,
                        publisherId: card.dataset.publisherId ? Number(card.dataset.publisherId) : null,
                    },
                    selection,
                );
                card.hidden = !match;
                if (match) visible++;
            }
            grid.hidden = visible === 0;
            emptyState.hidden = visible !== 0;
            count.textContent = `Showing ${visible} of ${cards.length} games`;

            const query = serializeFilters(selection).toString();
            history.replaceState(null, '', query ? `?${query}` : location.pathname);
        };

        form.addEventListener('change', apply);
        form.addEventListener('submit', (event) => event.preventDefault());
        clearButton.addEventListener('click', () => {
            writeSelection({ categoryIds: [], publisherIds: [] });
            apply();
        });

        writeSelection(parseFilters(new URLSearchParams(location.search)));
        apply();
    }
</script>
